<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Handle /admin route
  RewriteRule ^admin/?$ /admin/index.php [L]
  RewriteRule ^admin/(.*)$ /admin/$1 [L]
  
  # Skip rewrite for existing files and directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
</IfModule>
